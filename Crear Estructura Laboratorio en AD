<#
.SYNOPSIS
    Crea una estructura de laboratorio en Active Directory:
    - OU raíz con sub-OUs por departamento (Usuarios / Equipos dentro de cada una)
    - ~1000 usuarios repartidos entre los departamentos, con nombre y apellidos reales
    - sAMAccountName y UPN únicos en formato nombre.apellido (sin tildes/espacios)
    - Un grupo de seguridad por departamento, con los usuarios como miembros
    - Objetos de equipo de ejemplo por departamento

.NOTAS
    - Requiere el módulo ActiveDirectory (RSAT) y ejecutarse con permisos suficientes
      sobre el dominio (normalmente como Domain Admin) desde un DC o una máquina con RSAT.
    - Ajusta $DomainDN, $UPNSuffix y $UsersPerDept a tu entorno antes de ejecutar.
    - Ejecuta primero en un entorno de pruebas / laboratorio.
#>

#Requires -Modules ActiveDirectory

Import-Module ActiveDirectory -ErrorAction Stop

# ============================================================
#  CONFIGURACIÓN GENERAL
# ============================================================

# DN base del dominio. Ajusta a tu dominio real, ej: "DC=lab,DC=local"
$DomainDN   = (Get-ADDomain).DistinguishedName
$UPNSuffix  = (Get-ADDomain).DNSRoot

# Nombre de la OU raíz del laboratorio
$RootOUName = "Laboratorio"
$RootOUPath = $DomainDN

# Contraseña inicial para todos los usuarios de prueba (cámbiala / usa una política real)
